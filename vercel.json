{
  "functions": {
    "api/og.ts": {
      "includeFiles": "dist/public/**"
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/invite/:userId",
      "destination": "/api/og?path=/invite/:userId"
    },
    {
      "source": "/u/:userId",
      "destination": "/api/og?path=/u/:userId"
    },
    {
      "source": "/post/:postId",
      "destination": "/api/og?path=/post/:postId"
    },
    {
      "source": "/media/:mediaType/:source/:externalId",
      "destination": "/api/og?path=/media/:mediaType/:source/:externalId"
    },
    {
      "source": "/people/tribes/:tribeId",
      "destination": "/api/og?path=/people/tribes/:tribeId"
    },
    {
      "source": "/list/:listId",
      "destination": "/api/og?path=/list/:listId"
    },
    {
      "source": "/rank/:rankId",
      "destination": "/api/og?path=/rank/:rankId"
    },
    {
      "source": "/edna/:userId",
      "destination": "/api/og?path=/edna/:userId"
    },
    {
      "source": "/leaderboard",
      "destination": "/api/og?path=/leaderboard"
    },
    {
      "source": "/play",
      "destination": "/api/og?path=/play"
    },
    {
      "source": "/play/:path*",
      "destination": "/api/og?path=/play/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Applebot|Pinterestbot|SkypeUriPreview|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og?path=/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
